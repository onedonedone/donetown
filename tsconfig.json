{
    "compilerOptions": {
        "isolatedModules": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "noUncheckedSideEffectImports": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["vite/client"],
        "verbatimModuleSyntax": true
    },
    "exclude": ["notes/.vitepress/cache", "notes/.vitepress/dist"],
    "include": ["notes/.vitepress/**/*.ts"]
}
